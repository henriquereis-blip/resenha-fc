<title>Resenha FC</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Barlow+Condensed:wght@600;700;800&family=Playfair+Display:wght@700;900&display=swap">
<style>
:root{--bg:#f2f4f1;--card:#fff;--fg:#14201a;--mut:#5d6b63;--line:#d9dfda;--accent:#0a9a4a;--accent2:#ffcc00;--bad:#d6322d;--warn:#e29a00;--ok:#0a9a4a;--nav:#0d1f16;--navfg:#e8f2ec;--pitch:#2f8f3e}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b120e;--card:#14201a;--fg:#eaf3ed;--mut:#93a69a;--line:#26362d;--accent:#2fd36f;--accent2:#ffd426;--bad:#ff5a52;--warn:#ffb629;--ok:#2fd36f;--nav:#050907;--navfg:#e8f2ec;--pitch:#237a33;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0b120e;--card:#14201a;--fg:#eaf3ed;--mut:#93a69a;--line:#26362d;--accent:#2fd36f;--accent2:#ffd426;--bad:#ff5a52;--warn:#ffb629;--ok:#2fd36f;--nav:#050907;--navfg:#e8f2ec;--pitch:#237a33;color-scheme:dark}
body{margin:0}*{box-sizing:border-box}.fsel{font:700 15px Barlow;padding:9px;background:var(--card);color:var(--fg);border:1.5px solid var(--line);border-radius:9px;width:100%}.nav button{font-size:12px !important}
body{background:var(--bg);color:var(--fg);font:15px/1.35 Barlow,system-ui,sans-serif;padding-block:0 78px;padding-left:max(12px,env(safe-area-inset-left,0px));padding-right:max(12px,env(safe-area-inset-right,0px));-webkit-tap-highlight-color:transparent}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;text-align:inherit}
.wrap{max-width:720px;margin:0 auto;padding-top:10px;display:flex;flex-direction:column;gap:10px;min-width:0}
h2{font:800 20px 'Barlow Condensed';text-transform:uppercase;letter-spacing:.04em;margin:8px 0 0}
h3{font:800 22px 'Barlow Condensed';margin:0 0 4px}
.k{font-size:12px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em}
.hint,.news,.foot{color:var(--mut);font-size:13px;margin:2px 0}
.center{text-align:center}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;align-items:center;gap:8px;margin:0 -12px;padding:8px 12px;background:var(--nav);color:var(--navfg);border-bottom:3px solid var(--hc,var(--accent))}
.top b{font:800 20px 'Barlow Condensed';flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.top .meta{font-size:12px;opacity:.8;white-space:nowrap}.np{font-size:20px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--nav);z-index:10}
.nav{position:fixed;left:0;right:0;bottom:0;z-index:6;display:flex;background:var(--nav);padding:6px max(4px,env(safe-area-inset-right,0px)) calc(6px + env(safe-area-inset-bottom,0px)) max(4px,env(safe-area-inset-left,0px))}
.nav button{flex:1;text-align:center;color:var(--navfg);font:700 13px 'Barlow Condensed';letter-spacing:.05em;text-transform:uppercase;padding:9px 0;border-radius:8px;opacity:.7}
.nav button.on{background:var(--accent);color:#04120a;opacity:1}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px;min-width:0}
.hero{background:linear-gradient(135deg,var(--nav),#12402a);color:#fff;border:0}.hero .k{color:#b9d3c3}
.vsx{display:flex;align-items:center;justify-content:center;gap:18px;margin:8px 0}.vsx span{display:flex;flex-direction:column;align-items:center;font:800 22px 'Barlow Condensed'}.vsx i{font:800 26px 'Barlow Condensed';opacity:.6}
.row2{display:flex;gap:8px;margin-top:8px}.row2 .btn{flex:1}
.btn{display:inline-block;text-align:center;background:var(--accent);color:#04120a;font:800 16px 'Barlow Condensed';letter-spacing:.05em;text-transform:uppercase;padding:11px 16px;border-radius:10px}
.btn.big{padding:14px;font-size:19px;width:100%}.btn.sm{padding:6px 12px;font-size:14px}.btn.ghost{background:transparent;border:1.5px solid var(--line);color:inherit}.hero .btn.ghost{border-color:#ffffff55}.btn.on{border-color:var(--accent);color:var(--accent)}.btn[disabled]{opacity:.4}
.chk{display:flex;gap:8px;align-items:center;font-size:13px;margin-top:8px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tile{display:flex;flex-direction:column;gap:2px}.big{font:800 30px 'Barlow Condensed';line-height:1.05}
.ok{color:var(--ok)}.bad{color:var(--bad)}.warn{color:var(--warn)}
.pill{padding:2px 8px;border-radius:99px;font-size:11px;font-weight:700;text-transform:none;letter-spacing:0;background:var(--line)}
.meter{height:8px;background:var(--line);border-radius:9px;overflow:hidden;margin-top:6px}.meter i{display:block;height:100%;background:var(--ok)}.meter i.bad{background:var(--bad)}.meter i.warn{background:var(--warn)}
.mini{display:block;height:7px;background:var(--line);border-radius:9px;overflow:hidden;min-width:40px}.mini i{display:block;height:100%;background:var(--accent)}.mini.low i{background:var(--bad)}
.press .q{font:700 17px Barlow;margin:4px 0 8px}.opt{display:block;width:100%;padding:10px;margin-top:6px;border:1.5px solid var(--line);border-radius:10px}.opt:hover{border-color:var(--accent)}.opt.ghost{color:var(--mut)}
.paperc{display:block;width:100%;background:#f4ecd8;color:#1b1710;border:1px solid #cdbf98}.mast{font:900 22px 'Playfair Display',serif;border-bottom:2px double #1b1710;margin-bottom:6px;text-align:center}.paperc h3{font:900 21px 'Playfair Display',serif;line-height:1.15}.paperc p{margin:4px 0;font-family:Georgia,serif;font-size:14px}.paperc .k{color:#6b5f44}
.gazeta{background:#f4ecd8;color:#1b1710;padding:14px;border:1px solid #cdbf98;border-radius:4px}.mast.big{font-size:32px}.dateline{font-size:11px;text-align:center;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px}.mh{font:900 28px/1.1 'Playfair Display',serif}.by{font-style:italic;font-size:12px}.sub{font-family:Georgia,serif}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px}.cols article{background:#f4ecd8;color:#1b1710;padding:10px;border-radius:4px}.cols h4{font:900 17px 'Playfair Display',serif;margin:2px 0}.cols p{margin:4px 0;font:13px Georgia,serif}.pp{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#7a6c48}
.res{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--line);font-size:14px;width:100%}.res b{font-family:'Barlow Condensed';font-size:18px}.res.me{background:color-mix(in srgb,var(--accent) 14%,transparent);padding-inline:6px;border-radius:6px}.rt{text-align:right}.lk small{color:var(--mut)}
.seg{display:flex;gap:4px;background:var(--card);border:1px solid var(--line);padding:3px;border-radius:12px}.seg button{flex:1;text-align:center;padding:8px 4px;border-radius:9px;font:700 14px 'Barlow Condensed';text-transform:uppercase}.seg button.on{background:var(--accent);color:#04120a}.seg.sm button{padding:5px 8px;font-size:12px}.seg.scroll{overflow-x:auto}.seg.scroll button{flex:0 0 auto;padding-inline:12px}
.plist,.tbl{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.prow{display:grid;grid-template-columns:40px 1fr 62px 28px 34px 40px;gap:6px;align-items:center;padding:8px 10px;border-bottom:1px solid var(--line);width:100%}.prow.hd{font-size:11px;color:var(--mut);text-transform:uppercase}.prow.hurt{background:color-mix(in srgb,var(--bad) 10%,transparent)}
.pos{font:800 14px 'Barlow Condensed';color:var(--accent)}.nm{min-width:0;font-weight:600}.nm small{display:block;color:var(--mut);font-weight:400;font-size:11px}.ovr{font:800 20px 'Barlow Condensed';text-align:right}.car{font-size:11px;color:var(--mut)}.age{font-size:13px}
.tr{display:grid;grid-template-columns:26px 1fr 28px 28px 34px 34px;gap:4px;align-items:center;padding:7px 10px;border-bottom:1px solid var(--line);font-size:14px}.tr.t2{grid-template-columns:26px 1fr 34px 34px 38px 44px}.tr.hd{font-size:11px;color:var(--mut);text-transform:uppercase}.tc{display:flex;gap:6px;align-items:center;min-width:0;overflow:hidden;white-space:nowrap}.tr.me{background:color-mix(in srgb,var(--accent2) 22%,transparent);font-weight:700}.tr.g4{box-shadow:inset 3px 0 var(--ok)}.tr.z4{box-shadow:inset 3px 0 var(--bad)}
.clubs{display:grid;gap:6px}.club{display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--card);border:1.5px solid var(--line);border-radius:12px}.club.sel{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,var(--card))}.club .cn{flex:1;font-weight:700}.club small{display:block;color:var(--mut);font-weight:400}.rep{font:800 22px 'Barlow Condensed';color:var(--mut)}
.phils{display:grid;gap:6px}.phil,.offer{padding:10px 12px;background:var(--card);border:1.5px solid var(--line);border-radius:12px;display:block;width:100%}.phil.sel{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,var(--card))}.phil small,.offer small,.offer span{display:block;color:var(--mut);font-size:12px}.offer b{font:800 18px 'Barlow Condensed'}
.logo{font:800 56px 'Barlow Condensed';letter-spacing:.04em;margin-top:18px}.logo span{color:var(--bg);background:var(--accent);padding:0 10px;margin-left:8px;border-radius:6px}.lead{color:var(--mut);margin:0}
.fld{display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--mut);text-transform:uppercase;letter-spacing:.05em}.fld input,.fld select,.tools select{font:600 15px Barlow;padding:9px;background:var(--card);color:var(--fg);border:1.5px solid var(--line);border-radius:9px;text-transform:none;letter-spacing:0;width:100%}
.tools{display:flex;gap:8px;align-items:flex-end}.tools label{flex:1;display:flex;flex-direction:column;font-size:11px;color:var(--mut);text-transform:uppercase}
input[type=range]{width:100%;accent-color:var(--accent)}
.pitch{position:relative;width:100%;max-width:440px;margin:0 auto;aspect-ratio:3/4;border-radius:12px;background:repeating-linear-gradient(0deg,var(--pitch) 0 8.33%,color-mix(in srgb,var(--pitch) 86%,#000) 8.33% 16.66%);border:2px solid #0b3d1a;touch-action:pan-y;overflow:hidden}
.pitch .lines{position:absolute;inset:0;width:100%;height:100%}
.tok{position:absolute;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;width:68px;touch-action:none;user-select:none}
.shirt{display:grid;place-items:center;width:40px;height:40px;border-radius:50% 50% 9px 9px;border:3px solid var(--ring,#fff);box-shadow:0 2px 4px #0006}.shirt b{font:800 15px 'Barlow Condensed';color:#fff;text-shadow:0 0 3px #000,0 0 3px #000}.shirt.sm{width:30px;height:30px;border-width:2px}.shirt.sm b{font-size:13px}
.tn{display:flex;flex-direction:column;align-items:center;line-height:1.05;margin-top:1px}.tn i{font:700 11px Barlow;font-style:normal;color:#fff;text-shadow:0 1px 2px #000,0 0 2px #000;max-width:68px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tn small{font:700 9px Barlow;color:#d7ffe0;text-shadow:0 1px 2px #000}.tn small.off{color:#ffb4b0}
.tok.sel .shirt,.bn.sel{outline:3px solid var(--accent2)}.tok.hurt .shirt{filter:grayscale(.9)}.tok.sent{opacity:.35}.dragging{opacity:.3}.ghost{opacity:.9}
.nt{position:absolute;top:-6px;right:2px;font:800 10px Barlow;font-style:normal;background:#222;color:#fff;border-radius:6px;padding:0 4px}.nt.up{background:var(--ok)}.nt.dn{background:var(--bad)}
.sec{font:800 14px 'Barlow Condensed';text-transform:uppercase;letter-spacing:.08em;color:var(--mut);margin-top:4px}
.bench,.reserves{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:6px}
.bn{display:flex;align-items:center;gap:8px;padding:6px 8px;background:var(--card);border:1px solid var(--line);border-radius:10px;position:relative;touch-action:none;user-select:none;min-width:0}.bn .bt{display:flex;flex-direction:column;min-width:0}.bn .bt i{font-style:normal;font-weight:700;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bn small{font-size:11px;color:var(--mut)}.bn.hurt{opacity:.55}
.abar{position:sticky;bottom:64px;display:flex;gap:8px;align-items:center;background:var(--card);border:1.5px solid var(--accent);border-radius:12px;padding:8px 10px}.abar span{flex:1;font-weight:700}
.chips{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px}.chip{font-size:11px;font-weight:700;padding:2px 8px;border-radius:99px;background:color-mix(in srgb,var(--accent) 18%,transparent);color:var(--accent)}
.pf{display:flex;gap:12px;align-items:center}.pfo{text-align:center}.pfo b{font:800 44px 'Barlow Condensed';display:block;line-height:1;color:var(--accent)}.pfi{flex:1}
.at{display:grid;grid-template-columns:96px 1fr 38px;gap:8px;align-items:center;padding:3px 0;font-size:13px}.at.me span{font-weight:800;color:var(--accent)}.at b{text-align:right}
.back{color:var(--accent);font-weight:700;padding:4px 0}
.mrow{display:flex;gap:10px;align-items:center;padding:9px 10px;background:var(--card);border:1px solid var(--line);border-radius:10px;width:100%}.mrow .nm{flex:1}.col{display:flex;flex-direction:column;gap:4px}
.filt{display:flex;flex-direction:column;gap:8px}
.gm{display:grid;grid-template-columns:1fr auto 1fr;gap:6px;align-items:center;width:100%;padding:7px 8px;border-radius:9px;border:1px solid var(--line);margin-top:5px;font-size:14px}.gm .t1,.gm .t2{display:flex;align-items:center;gap:5px;font-weight:700}.gm .t2{justify-content:flex-end}.gm b{font:800 20px 'Barlow Condensed'}.gm small{grid-column:1/-1;text-align:center;color:var(--mut);font-size:11px}.gm.sel{border-color:var(--accent)}.gm.me{background:color-mix(in srgb,var(--accent2) 18%,transparent)}
.mh{display:flex;justify-content:space-between;align-items:center}.mh .tn{display:flex;flex-direction:column;align-items:center;font:800 22px 'Barlow Condensed'}.mh .tn i,.mh .tn b{color:var(--fg);text-shadow:none}.mh .sc{font:800 48px 'Barlow Condensed'}
.clock{text-align:center;font:800 20px 'Barlow Condensed';color:var(--accent)}
.track{position:relative;height:16px;background:var(--line);border-radius:9px;overflow:hidden;width:100%}.track i{position:absolute;left:0;top:0;bottom:0;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .15s}.track s{position:absolute;left:50%;top:0;bottom:0;width:2px;background:var(--bg)}
.ctrl{display:flex;gap:6px;flex-wrap:wrap}.ctrl .btn{flex:1;padding:9px 6px;font-size:14px}
.evs{max-height:260px;overflow:auto}.ev{display:grid;grid-template-columns:1fr 38px 1fr;gap:4px;padding:5px 0;border-bottom:1px solid var(--line);font-size:13px}.ev .t{text-align:center;font-weight:800;color:var(--mut)}.ev .r{text-align:left}.ev .l{text-align:right}.ev.goal{font-weight:800;color:var(--accent)}.ev.red{color:var(--bad)}
.mstats{display:grid;grid-template-columns:40px 1fr 40px;text-align:center;margin-top:8px;font-size:13px}.mstats b{font-weight:600;color:var(--mut)}
.ph{display:flex;gap:10px;align-items:center;font:800 18px 'Barlow Condensed'}.ph b{font-size:24px;color:var(--accent)}.ph .btn{margin-left:auto}.opp{font-size:13px;color:var(--mut)}
.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:10px 16px;border-radius:99px;z-index:50;font-weight:700;max-width:90vw}
.folder{display:block;width:100%;padding:8px 10px;border-bottom:1px solid var(--line);font-weight:700}.folder.sub{padding-left:26px;font-weight:600}.folder.sub2{padding-left:44px;font-weight:500}
.tabs2{display:flex;gap:6px}.tabs2 .btn{flex:1;padding:8px 4px;font-size:13px}
.troph{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px}.trp{text-align:center;padding:10px;border-radius:12px;background:linear-gradient(160deg,#fff3b0,#e9b923);color:#3a2a00}.trp b{font:800 30px 'Barlow Condensed';display:block}
.stad{display:grid;grid-template-columns:1fr auto;gap:6px}
.pen{border:2px solid var(--accent2);background:linear-gradient(160deg,#0c2a17,#143d22);color:#fff}.pen .k{color:var(--accent2)}.pl{margin:6px 0;font:600 15px Barlow;animation:fi .4s}.pl.ok{color:#5dff9a;font-weight:800}.pl.bad{color:#ff8a82;font-weight:800}@keyframes fi{from{opacity:0;transform:translateY(4px)}to{opacity:1}}
.tact{display:grid;grid-template-columns:minmax(0,1fr) 112px;gap:8px;align-items:start}.tp .pitch{max-width:none}.side .bench{grid-template-columns:1fr;gap:5px}.side .bn{padding:4px 6px;gap:5px}.side .bn .bt i{font-size:12px}.side .bn small{font-size:10px}.side .bn .nt{top:-5px;right:2px}
@media(max-width:520px){.tact .tok{width:50px}.tact .shirt{width:30px;height:30px;border-width:2px}.tact .shirt b{font-size:13px}.tact .tn i{font-size:10px;max-width:50px}.tact .tn small{font-size:8px}}
@media(min-width:600px){.tact{grid-template-columns:minmax(0,1fr) 200px}}
.oppbar{display:flex;flex-direction:column;gap:8px}.ob{display:flex;gap:10px;align-items:center}.ob b{font:800 20px 'Barlow Condensed'}.ob2{display:flex;gap:6px;align-items:center;flex-wrap:wrap}.fm{font-style:normal;font:800 12px Barlow;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;color:#fff}.fm.V{background:var(--ok)}.fm.E{background:var(--warn)}.fm.D{background:var(--bad)}.kits{margin-left:auto;display:flex;gap:4px}.kits s{width:22px;height:22px;border-radius:6px 6px 3px 3px;border:1px solid var(--line)}.tn small{white-space:nowrap}.tok{width:80px}@media(max-width:520px){.tact .tok{width:58px}.tact .tn small{font-size:7.5px}}

.top2{position:sticky;top:env(safe-area-inset-top,0px);z-index:7;margin:0 -12px;background:#000;color:#fff;display:flex;align-items:stretch}
.top2 .ic{display:flex;overflow-x:auto;flex:1;scrollbar-width:none}.top2 .ic::-webkit-scrollbar{display:none}
.top2 .ic button{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:1px;padding:6px 10px;min-width:58px;color:#fff;opacity:.8}.top2 .ic button span{font-size:22px;line-height:1.1}.top2 .ic small{font:700 10px Barlow;text-transform:none}.top2 .ic button.on{opacity:1;background:#1c1c1c;box-shadow:inset 0 -3px var(--accent2)}
.top2 .dt{align-self:center;font:800 14px 'Barlow Condensed';padding:0 10px;color:var(--accent2);white-space:nowrap}
.main{padding-top:0}
.nav2{position:fixed;left:0;right:0;bottom:0;z-index:6;display:flex;justify-content:space-around;align-items:flex-end;background:#000;padding:4px max(6px,env(safe-area-inset-right,0px)) calc(6px + env(safe-area-inset-bottom,0px)) max(6px,env(safe-area-inset-left,0px))}
.nav2 button{flex:1;display:flex;flex-direction:column;align-items:center;color:#fff;font-size:20px;padding:4px 0;opacity:.75}.nav2 button.on{opacity:1;color:var(--accent2)}.nav2 small{font:700 10px Barlow}
.nav2 .go{flex:0 0 92px;background:linear-gradient(180deg,var(--accent),#067a38);color:#04120a;border-radius:16px;opacity:1;margin:-16px 6px 0;padding:8px 0;box-shadow:0 4px 14px #0008;font-size:26px}.nav2 .go small{font:800 13px 'Barlow Condensed';letter-spacing:.08em}
.home{display:grid;grid-template-columns:1fr;gap:10px;padding-top:10px}
@media(min-width:760px){.home{grid-template-columns:300px 1fr}.wrap{max-width:900px}}
.cpanel{border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:8px;box-shadow:0 2px 0 #0004}.cp1{display:flex;gap:10px;align-items:center}.cpanel h2{margin:0;font:800 26px 'Barlow Condensed';letter-spacing:0;text-transform:none}.sm,.sm2{font-size:12px;opacity:.85}
.cp2{display:flex;justify-content:space-between;font:700 15px Barlow;color:inherit;padding:6px 8px;background:#0003;border-radius:8px}
.bars{display:grid;grid-template-columns:1fr 1fr;gap:8px}.bars small{font-size:11px;font-weight:700}.bar2{position:relative;height:18px;background:#0005;border:1px solid #0008;border-radius:4px;overflow:hidden}.bar2 i{display:block;height:100%;background:#fff}.bar2 b{position:absolute;inset:0;display:grid;place-items:center;font:800 11px Barlow;color:#000;mix-blend-mode:normal;text-shadow:0 0 3px #fff}
.nx{background:#000;border-radius:8px;overflow:hidden}.nxh{background:#000;color:var(--tc);font:800 13px 'Barlow Condensed';letter-spacing:.06em;text-transform:uppercase;padding:5px 8px;border-bottom:1px solid #fff3}.nxb{display:flex;gap:10px;align-items:center;padding:8px;background:#0002;color:#fff}.nxb b{font:800 18px 'Barlow Condensed'}
.bigbtn{background:linear-gradient(#f4f6f8,#c9d2da);color:#102030;font:800 17px 'Barlow Condensed';letter-spacing:.04em;text-transform:uppercase;padding:12px;border-radius:8px;border:1px solid #0006;text-align:center}
.pc{background:#0004;border-radius:8px;padding:8px;display:flex;flex-direction:column;gap:3px}.pch{display:flex;justify-content:space-between;font:800 17px 'Barlow Condensed'}.pcg{display:flex;gap:10px;font-size:12px;flex-wrap:wrap}
.sqw{overflow-x:auto;background:var(--card);border:1px solid var(--line);border-radius:10px}.sq{border-collapse:collapse;width:100%;font-size:12.5px;min-width:520px}.sq th{position:sticky;top:0;background:var(--nav);color:#fff;font:700 11px Barlow;padding:6px 5px;text-align:center}.sq td{padding:6px 5px;border-bottom:1px solid var(--line);text-align:center;white-space:nowrap}.sq .nmc{text-align:left;font-weight:600;max-width:150px;overflow:hidden;text-overflow:ellipsis}.sq .p{font:800 14px 'Barlow Condensed';color:var(--accent)}.sq tr{cursor:pointer}.sq tr.sel{background:color-mix(in srgb,var(--accent2) 35%,transparent)}.sq tr.hurt{color:var(--bad)}.sq .old{color:var(--bad)}.sq .yng{color:#2e7dd7}.sq td.bad{color:var(--bad)}
.en{position:relative;display:block;width:66px;height:16px;background:var(--line);border:1px solid #0003;border-radius:3px;overflow:hidden}.en i{display:block;height:100%;background:var(--c,#d22)}.en u{position:absolute;inset:0;display:grid;place-items:center;text-decoration:none;font:800 10px Barlow;color:#fff;text-shadow:0 0 2px #000}
.achb{display:block;width:calc(100% + 24px);margin:0 -12px;background:linear-gradient(90deg,#ffd426,#ff9d00);color:#2a1d00;font:800 14px 'Barlow Condensed';padding:8px 12px;text-align:center}
.ach{display:flex;gap:12px;align-items:center;opacity:.55}.ach.got{opacity:1;border-color:var(--accent2)}.ai{font-size:30px}
.flash{position:fixed;left:0;right:0;top:34%;z-index:60;text-align:center;pointer-events:none;animation:pop .35s ease-out}.flash b{display:block;font:900 64px 'Barlow Condensed';letter-spacing:.06em;text-shadow:0 4px 0 #0008}.flash span{font:800 22px 'Barlow Condensed';color:#fff;text-shadow:0 2px 0 #000}.flash.win b{color:var(--accent2)}.flash.lose b{color:#ff6b62;font-size:44px}
@keyframes pop{from{transform:scale(.4);opacity:0}to{transform:scale(1);opacity:1}}
.ev.info{display:block;text-align:center;color:var(--mut);font-style:italic;font-size:12px}
.confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:40}.confetti s{position:absolute;top:-12px;width:8px;height:14px;animation:fall linear infinite}@keyframes fall{to{transform:translateY(110vh) rotate(540deg)}}
body{padding-bottom:84px}
.home>*{min-width:0}.hr{display:flex;flex-direction:column;gap:10px}.flash{background:linear-gradient(transparent,rgba(0,0,0,.72) 25%,rgba(0,0,0,.72) 75%,transparent);padding:22px 0}
html,body{overflow-x:hidden}
</style>
<style>
body:has(.mt){background:#050b07}
@media(min-width:760px){.mt{max-width:560px;margin:0 auto;border-radius:16px;border:1px solid #1f3327}}
.live .dt{border:2px solid #fff;box-shadow:0 0 0 1px #0007}
/* ===== v3: telas que cabem na tela ===== */
body:has(.fit){padding-bottom:0}
.fit{display:flex;flex-direction:column;gap:6px;min-height:0;overflow:hidden;padding-top:6px;position:relative}
.fit>*{min-width:0}
.ostrip{display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:6px 10px;flex:0 0 auto}
.ostrip .ot{flex:1;min-width:0;display:flex;flex-direction:column;line-height:1.15}.ostrip .ot b{font:800 16px 'Barlow Condensed';white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ostrip .ot small{font-size:11px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ostrip .of{display:flex;gap:2px}.ostrip .kits{display:flex;flex-direction:column;gap:2px}.ostrip .kits s{width:14px;height:10px;border-radius:3px;border:1px solid #0004}
.ctl4{display:grid;grid-template-columns:1fr 1fr;gap:5px;flex:0 0 auto}
@media(min-width:560px){.ctl4{grid-template-columns:repeat(4,1fr)}}
.sl{display:flex;flex-direction:column;gap:1px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:3px 8px 2px}
.sl small{font:700 9px Barlow;text-transform:uppercase;letter-spacing:.07em;color:var(--mut)}
.sl select{font:700 14px Barlow;background:transparent;color:var(--fg);border:0;padding:0;width:100%;outline:0}
.fit .tact{width:100%;align-self:stretch;margin:0;flex:1 1 0;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 112px;gap:6px;align-items:stretch}
@media(min-width:620px){.fit .tact{grid-template-columns:minmax(0,1fr) 170px}}
.fit .tp{position:relative;min-height:0;min-width:0;display:flex;justify-content:center}
.fit .pitch{height:100%;width:100%;max-width:none;aspect-ratio:auto;margin:0}
@media(min-aspect-ratio:1/1) and (min-width:620px){.fit .pitch{aspect-ratio:3/4;width:auto;max-width:100%}}
.fit .side{min-height:0;overflow-y:auto;display:flex;flex-direction:column;gap:4px;scrollbar-width:thin}
.fit .side .sec{margin:2px 0 0;font-size:11px}
.fit .reserves{display:flex;flex-direction:column;gap:4px}
.fit .reserves .bn{padding:3px 6px}
.fit .bench{gap:4px}.fit .side .bn{padding:3px 5px}
.abar.abs{position:absolute;left:6px;right:6px;bottom:6px;z-index:5;padding:5px 8px;box-shadow:0 4px 16px #0006}
.acts{display:flex;gap:6px;flex:0 0 auto}.acts .btn{flex:1;padding:10px 6px}
.sheet{position:absolute;left:0;right:0;bottom:56px;z-index:8;box-shadow:0 8px 30px #0008}
/* ===== transmissão ===== */
.mt{background:linear-gradient(180deg,#07110b,#0d1f16 40%,#07110b);color:#eaf3ed;margin:0 -12px;padding:8px 12px 10px;max-width:none;--line:#25382d;--mut:#93a69a;--card:#12241a;--fg:#eaf3ed}
.mt .btn.ghost{color:#eaf3ed;border-color:#3b5446}.mt .btn.ghost.on{background:var(--accent);color:#04120a;border-color:var(--accent)}
.sb{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:6px;flex:0 0 auto}
.tm1{display:flex;align-items:center;gap:8px;font:800 24px 'Barlow Condensed';letter-spacing:.03em}.tm1.r{justify-content:flex-end}
.mid{display:flex;flex-direction:column;align-items:center;line-height:1}.mid .sc{font:800 44px 'Barlow Condensed';letter-spacing:.02em}
.clk{font:800 13px 'Barlow Condensed';background:#ffffff18;border-radius:20px;padding:2px 10px;color:var(--accent2);margin-top:2px}.clk.end{background:var(--accent);color:#04120a}
.live{position:relative;flex:0 0 auto;height:min(25dvh,200px);border-radius:12px;overflow:hidden;background:repeating-linear-gradient(90deg,#1f7a33 0 10%,#1b6e2d 10% 20%);border:1.5px solid #0b3d1a}
.live .lines{position:absolute;inset:0;width:100%;height:100%}
.live .dt{position:absolute;width:11px;height:11px;border-radius:50%;transform:translate(-50%,-50%);transition:left .5s,top .5s}
.live .ball{position:absolute;top:50%;width:90px;height:90px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(255,236,120,.55),rgba(255,236,120,0) 68%);transition:left .7s ease}
.pres{display:flex;align-items:center;gap:8px;font:800 12px 'Barlow Condensed';color:var(--mut);flex:0 0 auto}.pres span{width:34px}.pres span:last-child{text-align:right}
.pb{flex:1;height:6px;background:linear-gradient(90deg,var(--accent),#ffffff22 50%,#ff5a52);border-radius:6px;position:relative}.pb i{position:absolute;top:-4px;width:6px;height:14px;background:#fff;border-radius:3px;transform:translateX(-50%);transition:left .6s}
.tline{position:relative;height:26px;flex:0 0 auto}.tline .tk{position:absolute;left:0;right:0;top:11px;height:4px;background:#ffffff1f;border-radius:4px;overflow:hidden}.tline .tk i{display:block;height:100%;background:var(--accent2)}
.tline .tm{position:absolute;font-size:12px;transform:translateX(-50%);line-height:1}.tline .tm.h{top:-2px}.tline .tm.a{top:14px}
.ticker{position:relative;flex:1 1 0;min-height:60px;overflow:hidden;display:flex;flex-direction:column;gap:3px;mask-image:linear-gradient(180deg,#000 80%,transparent)}
.tr2{display:grid;grid-template-columns:34px 22px 1fr;gap:4px;align-items:center;padding:5px 8px;border-radius:9px;background:#ffffff0a;font-size:13px;border-left:3px solid #ffffff22}
.tr2.h{border-left-color:var(--accent)}.tr2.a{border-left-color:#ff5a52}
.tr2.goal{background:#ffd42622;font-weight:700}.tr2 .mn{font:800 13px 'Barlow Condensed';color:var(--accent2)}
.mt .ev.info{padding:2px 8px}
.pen.ov{position:absolute;left:4px;right:4px;top:4px;z-index:4;background:#000d;border:1px solid var(--accent2)}
.sbars{display:grid;grid-template-columns:1fr 1fr;gap:8px;flex:0 0 auto}
.sbar{display:grid;grid-template-columns:22px 1fr 22px;gap:4px;align-items:center;font:800 13px 'Barlow Condensed'}.sbar small{grid-column:1/-1;font:600 10px Barlow;color:var(--mut);text-align:center;margin-top:-2px}
.sbar .bb{height:6px;border-radius:4px;background:#ffffff14;display:flex;overflow:hidden;gap:2px}.sbar .bb i,.sbar .bb s{display:block;height:100%}.sbar b:last-child{text-align:right}
.ctrl2{display:flex;gap:6px;flex:0 0 auto}.ctrl2 .btn{padding:9px 10px}.ctrl2 .btn.big{flex:1}
.gchips{display:flex;gap:5px;overflow-x:auto;flex:0 0 auto;scrollbar-width:none}.gchips::-webkit-scrollbar{display:none}
.gc{flex:0 0 auto;font:700 12px 'Barlow Condensed';padding:5px 9px;border-radius:20px;background:#ffffff10;border:1px solid #ffffff18;white-space:nowrap}.gc.sel{border-color:var(--accent2);color:var(--accent2)}.gc.me{background:#2fd36f22}
</style>
